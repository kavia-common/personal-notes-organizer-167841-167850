#!/usr/bin/env bash
# CI wrapper to be used instead of './gradlew' in Expo-managed projects.
# Usage: ./gradlew-ci <task> (e.g., './gradlew-ci check')
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$ROOT_DIR/notes_frontend"
REAL="$APP_DIR/android/gradlew"

if [ -f "$REAL" ]; then
  echo "[gradlew-ci] Native present. Delegating to: $REAL $*"
  chmod +x "$REAL"
  exec "$REAL" "$@"
else
  echo "[gradlew-ci] No android/gradlew found. Skipping Gradle step."
  echo "[gradlew-ci] To enable, run: cd notes_frontend && npm run prebuild:android"
  exit 0
fi
